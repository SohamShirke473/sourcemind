# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Local PostgreSQL running in Docker (with pgvector extension)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sourcemind?sslmode=disable"

# ─── BETTER AUTH ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="<openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3000"

# ─── EVENT ORCHESTRATION ──────────────────────────────────────────────────────
# Set to 1 for local Inngest background dev server polling
INNGEST_DEV=1

# ─── CLOUDFLARE R2 FILE STORAGE ────────────────────────────────────────────────
# Credentials for S3-compatible R2 storage for PDF uploads, audio files, and infographics
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="sourcemind"

# ─── SCRAPERS & WEB INGESTION ──────────────────────────────────────────────────
# API key for firecrawl.xyz to scrape JS-rendered pages and turn them into Markdown
FIRECRAWL_API_KEY="fc-..."

# ─── AI PROVIDERS & GATEWAY ────────────────────────────────────────────────────
# API key for Google Gemini / Imagen direct requests
GOOGLE_GENERATIVE_AI_API_KEY="AQ..."
GEMINI_API_KEY="AQ..."

# Vercel AI Gateway key to proxy and manage model routing
AI_GATEWAY_API_KEY="vck_..."
